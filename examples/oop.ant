// Class declaration
class Person {
	eat(something) {
		print "eating " + something;
	}

	sleep() {
		print "sleeping Zzzzz";
	}
}

// Object
var p = Person(); // Instantiation

// Setting properties
p.name = "Test";
p.age = 20;

// Getting properties
print "name is: " + p.name;
print "age is: ";
print p.age;

// Methods invokation
p.eat("Pizza");
p.sleep();
