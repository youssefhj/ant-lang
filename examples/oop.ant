// Class declaration
class Person {
	// Constructor
	init(name, age) {
		// 'this' is a special variable 
		//        that refrence to the current object
		this.name = name;
		this.age = age;
	}

	eat(something) {
		print "eating " + something;
	}

	sleep() {
		print "sleeping Zzzzz";
	}
}

// Object
var p = Person("Test", 20); // Instantiation

// Getting properties
print "name is: " + p.name;
print "age is: ";
print p.age;
print "";

// Setting properties
p.age = 25;
print "Am getting older ";
print p.age;
print "";

// Methods invokation
p.eat("Pizza");
p.sleep();
