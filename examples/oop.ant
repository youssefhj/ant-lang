// Class declaration
// superclass
class Person {
	// Constructor
	init(name, age) {
		// 'this' is a special variable 
		//        that refrence to the current object
		this.name = name;
		this.age = age;
	}

	eat(something) {
		print "eating " + something;
	}

	sleep() {
		print "sleeping Zzzzz";
	}
}

// Inheritance
// subclass
class AntDeveloper < Person {
	eat(something) {
		// 'super' is a special variable
		//         that refrence to the super class
		super.eat(something);
		print "while coding :)";
	}
}

// Object
var p = AntDeveloper("Dev", 20); // Instantiation

// Getting properties
print "name is: " + p.name;
print "age is: ";
print p.age;
print "";

// Setting properties
p.age = 25;
print "Am getting older ";
print p.age;
print "";

// Methods invokation
p.eat("Pizza");
p.sleep();
