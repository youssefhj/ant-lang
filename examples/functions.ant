var start = clock(); // native function
print "start time: ";
print start;
print "";

func sayHello(message) {
	print "Hello "  + message;
}

sayHello("ant Developers :)");

func outer() {
	var a = 2026;
	func inner() {
		print a;
	}

	a = 2027;
	return inner;
}

var f = outer();

f();
print "";

var end = clock();
print "end time: ";
print end;
print "";

print "Execution time is: ";
print end - start;
