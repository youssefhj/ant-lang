var start = clock(); // native function
print "start time: ";
print start;
print "";

func outer() {
	var a = 2;
	func inner() {
		print a;
	}

	a = 5;
	return inner;
}

var f = outer();

f();
print "";

var end = clock();
print "end time: ";
print end;
print "";

print "Execution time is: ";
print end - start;
